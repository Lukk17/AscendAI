# AscendAI: secrets and per-deployment overrides.
# Copy to `.env` (gitignored) and fill in the keys you actually use.
# `docker compose` reads this file automatically from the repo root.

# ─── Provider API keys (ascend-ai-agent, AscendMemory, ascend-audio-scribe) ───
OPENAI_API_KEY=
ASCEND_ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=

# ─── ascend-audio-scribe ───
# Hugging Face Inference API token. Required only for the HF transcription backend.
HF_TOKEN=

# ─── ascend-web-hunter ───
# Ngrok auth token for the NoVNC CAPTCHA-intervention tunnel. Required only
# when running the scrapper stack with the ngrok-ascend-web-hunter profile.
NGROK_AUTHTOKEN=

# SearXNG session-signing key. Required: the scrapper stack refuses to start
# without it, and SearXNG itself refuses to boot without it too.
# Needs at least 32 characters, unique to this deployment, and cannot be the
# literal string `ultrasecretkey` (SearXNG rejects it).
SEARXNG_SECRET=

# Password for the NoVNC desktop used to solve CAPTCHAs by hand. Optional
# locally: an empty value means the desktop is passwordless and accepts any
# client, and the container logs a warning at boot to that effect.
# The VNC protocol truncates it to 8 characters, so anything longer is
# silently cut down.
# Required in the standalone deployment (apps/ascend-web-hunter/deploy-standalone).
VNC_PASSWORD=

# Hosts the URI fetch guard may reach even at a private address. Compose passes
# this to ascend-web-hunter as ALLOWED_PRIVATE_HOSTS. Leave empty, only the
# start command of an end-to-end sweep sets it, in its own shell.
WEB_HUNTER_ALLOWED_PRIVATE_HOSTS=

# Service port for ascend-web-hunter. Optional: the code default `7021` applies when unset.
# WEB_HUNTER_API_PORT=7021
# Bind address. Optional: the code default `0.0.0.0` applies when unset.
# API_HOST=0.0.0.0
# Logging level. Optional: the code default `INFO` applies when unset.
# LOG_LEVEL=INFO
# Log format. Optional: the code default `json` applies when unset.
# LOG_FORMAT=json
# Flood-protection rate limit for ascend-web-hunter REST routes and MCP tools.
# Optional: the code default `1200/minute` applies when unset.
# WEB_HUNTER_RATE_LIMIT_DEFAULT=1200/minute
# Seconds each readiness probe may take. Optional: the code default `3` applies when unset.
# READINESS_PROBE_TIMEOUT_SECONDS=3
# Seconds each startup banner check may take. Optional: the code default `2` applies when unset.
# STARTUP_PROBE_TIMEOUT_SECONDS=2
# Max age of the strict-transport-security header. Optional: the code default `63072000` applies when unset.
# SECURITY_HSTS_MAX_AGE_SECONDS=63072000
# Redirect hops the URI fetch guard follows. Optional: the code default `10` applies when unset.
# WEB_HUNTER_FETCH_MAX_REDIRECT_HOPS=10
# OpenTelemetry's standard switch. Optional: the code default `false` applies when unset.
# OTEL_SDK_DISABLED=false

# Shared Redis connection string. ascend-memory, ascend-audio-scribe, ascend-ocr
# and ascend-web-hunter all read it: each service keeps its shared rate limit
# windows in it under its own key prefix, and ascend-web-hunter also keeps its
# sessions in it. Optional: defaults in compose to this machine's own
# external-prerequisite Redis at redis://host.docker.internal:6379/0.
# Only needed to point at the optional bundled
# `redis` service in compose.ascend-web-hunter.yaml instead
# (redis://redis:6379/0), which stays off unless started with
# `docker compose --profile redis up`.
REDIS_URL=
# Running compose.ascend-web-hunter.yaml alone on a machine with no host
# Redis needs both lines below. Uncomment them together.
# Enable to start the bundled `redis` service, which stays off without the profile.
# COMPOSE_PROFILES=redis
# Enable to point ascend-web-hunter at that bundled service instead of the host's Redis.
# REDIS_URL=redis://redis:6379/0

# ─── ascend-ai-agent: chat-history backend toggles ───
# Both default to `true` in compose.yaml. Uncomment and set to `false`
# to opt the agent out of that persistence layer. With BOTH set to false the
# agent retains no turn-by-turn transcripts and relies entirely on semantic
# memory (Qdrant via AscendMemory) for cross-turn coherence.
# The env-var names use Spring Boot's canonical form for kebab-case
# properties, hyphens removed: `CHATHISTORY`, not `CHAT_HISTORY`.
# APP_MEMORY_CHATHISTORY_REDIS_ENABLED=true
# APP_MEMORY_CHATHISTORY_POSTGRES_ENABLED=true

# ─── ascend-ai-agent: chat-history compaction ───
# Async summarisation of older turns once a conversation crosses the configured
# threshold (default: 20 turns OR 50% of provider context). Set to false to keep
# raw history forever. Per-provider compaction-model map lives in
# apps/ascend-ai-agent/src/main/resources/application.yaml under
# app.memory.chat-history.compaction.provider-defaults.
# APP_MEMORY_CHATHISTORY_COMPACTION_ENABLED=true

# ─── ascend-ocr: result store credentials ───
# ascend-ocr writes every finished document's Markdown to its own `ocr-results`
# bucket in the same S3-compatible object store the agent uses (Floci locally).
# Both default to the local Floci credentials in compose.yaml; set them here when
# the store is not the local one.
# OCR_RESULT_S3_ACCESS_KEY=admin
# OCR_RESULT_S3_SECRET_KEY=password

# ─── postgres-exporter: data-layer metrics ───
# Postgres connection for the postgres-exporter service in compose.yaml
# (DATA_SOURCE_URI is fixed there). Fill in the credentials of the
# external-prerequisite Postgres holding database 'ascend_ai'.
DATA_SOURCE_USER=
DATA_SOURCE_PASS=

# ─── Observability retention (add-observability, design D13) ───
# Loki log retention window, read in infra/observability/loki/loki-config.yaml (default 2160h).
# LOKI_RETENTION_PERIOD=2160h
# Tempo trace retention window, read in infra/observability/tempo/tempo-config.yaml (default 2160h).
# TEMPO_BLOCK_RETENTION=2160h
# Prometheus metrics retention window, read as --storage.tsdb.retention.time in compose.yaml (default 72h).
# PROMETHEUS_RETENTION_TIME=72h
