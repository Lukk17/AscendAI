# e2e manual test run records — ephemeral, one per sweep. Keep the README,
# ignore the timestamped run files. Move a particular run into version control
# manually if you want it as an audit artifact.
apps/ascend-ai-agent/e2e/testing/runs/*
!apps/ascend-ai-agent/e2e/testing/runs/README.md
apps/ascend-weather-mcp/e2e/testing/runs/*
!apps/ascend-weather-mcp/e2e/testing/runs/README.md
apps/ascend-memory/e2e/testing/runs/*
!apps/ascend-memory/e2e/testing/runs/README.md
apps/ascend-web-hunter/e2e/testing/runs/*
!apps/ascend-web-hunter/e2e/testing/runs/README.md
apps/ascend-audio-scribe/e2e/testing/runs/*
!apps/ascend-audio-scribe/e2e/testing/runs/README.md
apps/ascend-ocr/e2e/testing/runs/*
!apps/ascend-ocr/e2e/testing/runs/README.md

# Bruno CLI run-output dump. Bruno writes the report next to the collection
# root when invoked with `--output` (the file is named after the format —
# `json`, `junit.xml`, etc.). Transient test output, not source.
docs/api/request/AscendAI/json
docs/api/request/AscendAI/junit.xml


# =============================================================================
# Language & Framework Specific
# =============================================================================
# --- Java / Gradle ---
.gradle
build/
bin/
# Allow gradle wrapper
!gradle/wrapper/gradle-wrapper.jar
# Allow nested build/bin directories in src
!**/src/main/**/build/
!**/src/test/**/build/
!**/src.main/**/bin/
!**/src.test/**/bin/

# --- Python ---
# Virtual environments
.venv/
venv/
env/

