# AscendWebSearch standalone deployment — secrets.
# Copy to `.env` in this same directory and fill in every value.
# `docker compose` reads this file automatically. All three are required:
# the stack refuses to start when any is missing.

# SearXNG session-signing key.
# Requirements: at least 32 characters, unique to this deployment, never the
# literal string `ultrasecretkey` (SearXNG rejects it). Not a value you ever
# type by hand, so length costs nothing.
SEARXNG_SECRET=

# Password for the NoVNC desktop that handles CAPTCHA intervention.
# Requirements: exactly 8 characters or fewer. The VNC protocol truncates
# anything longer, so a 20-character password is silently cut to its first 8
# and the rest do nothing.
VNC_PASSWORD=

# Ngrok auth token for the public NoVNC tunnel. Free account is sufficient.
# Get one at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
