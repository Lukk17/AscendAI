# AscendWebSearch e2e — credentials for the authenticated section of test 7.
# Copy this file to `.env.local` IN THIS DIRECTORY (AscendWebSearch/e2e/) and fill
# in real values. `.env.local` is gitignored and must NEVER be committed.
# These defaults use the public saucedemo.com test app, so any developer can run
# the authenticated e2e section without a private account.
#
# This is separate from the project-root `.env.example` (app secrets) — it lives
# next to the e2e suite because it is only used by the e2e login harness.

# URL of the login page the seed harness will navigate to.
E2E_LOGIN_URL=https://www.saucedemo.com/

# Credentials for the scripted login.
E2E_LOGIN_USER=standard_user
E2E_LOGIN_PASS=secret_sauce

# URL that is only accessible when the user is authenticated.
# The authenticated Bruno request reads this URL and expects E2E_LOGIN_SUCCESS_MARKER
# to appear in the response content.
E2E_LOGIN_SECURE_URL=https://www.saucedemo.com/inventory.html

# A phrase that appears on the authenticated page but not on the login/redirect page.
# Used by auth-read-secure.yml to confirm that session replay returned logged-in content.
E2E_LOGIN_SUCCESS_MARKER=Sauce Labs Backpack

# CSS selectors used by the seed harness to fill and submit the login form.
# These defaults match saucedemo's DOM; override when swapping in a different site.
E2E_LOGIN_USERNAME_SELECTOR=#user-name
E2E_LOGIN_PASSWORD_SELECTOR=#password
E2E_LOGIN_SUBMIT_SELECTOR=#login-button
