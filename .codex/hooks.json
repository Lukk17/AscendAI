{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|NotebookEdit|Bash|WebFetch|WebSearch)$",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && python .agents/hooks/preflight_gate.py --format claude ; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'PREFLIGHT: before code work, name the skills and subagents that own this task and invoke them, or say none apply and why. Delegate investigation, review and bounded implementation by default.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && python .agents/hooks/no_ai_markers_check.py ; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
