# ascend-web-hunter standalone deployment - secrets.
# Copy to `.env` in this same directory and fill in every value.
# `docker compose` reads this file automatically. SEARXNG_SECRET and
# NGROK_AUTHTOKEN are required: the stack refuses to start when either is
# missing. VNC_PASSWORD and REDIS_URL are optional, see their own comments
# below.

# SearXNG session-signing key.
# Requirements: at least 32 characters, unique to this deployment, never the
# literal string `ultrasecretkey` (SearXNG rejects it). Not a value you ever
# type by hand, so length costs nothing.
SEARXNG_SECRET=

# Password for the NoVNC desktop that handles CAPTCHA intervention.
# Optional: an empty value means the desktop accepts any client, and the
# container logs a warning at boot. The ngrok tunnel puts the desktop on the
# internet, so anyone who reaches that address can then control the browser.
# Set one when the deployment is reachable beyond a trusted network.
# Requirements when set: 8 characters or fewer. The VNC protocol truncates
# anything longer, so a 20-character password is silently cut to its first 8
# and the rest do nothing.
VNC_PASSWORD=

# Ngrok auth token for the public NoVNC tunnel. Free account is sufficient.
# Get one at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# One base address shared by every container: the web-hunter edge proxy added later by scale-web-hunter-across-containers, empty for one container.
NOVNC_PUBLIC_URL=
# Maximum concurrent intervention windows per container, a memory constraint as much as a display one. Optional: the code default `4` applies when unset.
# NOVNC_MAX_CONCURRENT_FLOWS=4
# Size of the shared Xvfb display as <width>x<height>, read by Xvfb and the service. Optional: the code default `1920x1080` applies when unset.
# NOVNC_DISPLAY_SIZE=1920x1080
# Width in pixels of each intervention window. Optional: the code default `1280` applies when unset.
# NOVNC_WINDOW_WIDTH_PX=1280
# Height in pixels of each intervention window. Optional: the code default `800` applies when unset.
# NOVNC_WINDOW_HEIGHT_PX=800
# Cascade step in pixels between intervention windows. Optional: the code default `48` applies when unset.
# NOVNC_WINDOW_CASCADE_OFFSET_PX=48
# Teardown grace added on top of the flow timeout before a held flow is reclaimed. Optional: the code default `30.0` applies when unset.
# NOVNC_FLOW_LEASE_GRACE_SECONDS=30.0
# Interval in seconds between lease-sweeper runs. Optional: the code default `30.0` applies when unset.
# NOVNC_FLOW_SWEEP_INTERVAL_SECONDS=30.0
# Bounds reclamation, shutdown and a window close. Optional: the code default `10.0` applies when unset.
# NOVNC_FLOW_CANCEL_GRACE_SECONDS=10.0
# Short poll interval answered in the 409 Retry-After header. Optional: the code default `30` applies when unset.
# NOVNC_BUSY_RETRY_AFTER_SECONDS=30

# Service port. Optional: the code default `7021` applies when unset.
# WEB_HUNTER_API_PORT=7021
# Host port. Optional: the default `7021` applies when unset.
# WEB_HUNTER_HOST_PORT=7021
# Bind address. Optional: the code default `0.0.0.0` applies when unset.
# API_HOST=0.0.0.0
# Logging level. Optional: the code default `INFO` applies when unset.
# LOG_LEVEL=INFO
# Log format. Optional: the code default `json` applies when unset.
# LOG_FORMAT=json
# Flood-protection rate limit for REST routes and MCP tools.
# Optional: the code default `1200/minute` applies when unset.
# WEB_HUNTER_RATE_LIMIT_DEFAULT=1200/minute
# Seconds each readiness probe may take. Optional: the code default `3` applies when unset.
# READINESS_PROBE_TIMEOUT_SECONDS=3
# Seconds each startup banner check may take. Optional: the code default `2` applies when unset.
# STARTUP_PROBE_TIMEOUT_SECONDS=2
# Max age of the strict-transport-security header. Optional: the code default `63072000` applies when unset.
# SECURITY_HSTS_MAX_AGE_SECONDS=63072000
# Redirect hops the URI fetch guard follows. Optional: the code default `10` applies when unset.
# WEB_HUNTER_FETCH_MAX_REDIRECT_HOPS=10
# Host names the /mcp endpoint accepts in the Host header (inbound). Optional: the code
# default `ascend-web-hunter,localhost,127.0.0.1` applies when unset. Set this when callers
# reach the service under another host name; it fills MCP_ALLOWED_HOST_HEADERS of the container.
# WEB_HUNTER_MCP_ALLOWED_HOST_HEADERS=ascend-web-hunter,localhost,127.0.0.1
# Prefix length scanned by the vendor, structure and phrase families. Optional: the code default `50000` applies when unset.
# CHALLENGE_DETECTION_MAX_BYTES=50000
# Page size under which a 403, 429 or 503 body counts as small, and under which the word floor is computed. Optional: the code default `50000` applies when unset.
# CHALLENGE_WALL_MAX_BYTES=50000
# Score at or above which a page is a challenge wall.
# CHALLENGE_SCORE_THRESHOLD=100
# Extracted words at or above which the rich-content guard fires.
# CHALLENGE_RICH_CONTENT_WORDS=150
# Share of visible text inside forms at or above which form dominance fires.
# CHALLENGE_FORM_DOMINANCE_RATIO=0.6
# Extracted words per kilobyte of HTML under which thin text fires.
# CHALLENGE_MIN_WORDS_PER_KB=2.0
# Fewer anchors with href than this fires few links.
# CHALLENGE_THIN_LINK_COUNT=5
# At least this many anchors with href fires the many-links guard.
# CHALLENGE_RICH_LINK_COUNT=20
# Bounds the extraction the shape family uses.
# CHALLENGE_SHAPE_MAX_BYTES=500000
# Weight of the definitive_header signal.
# CHALLENGE_WEIGHT_DEFINITIVE_HEADER=200
# Weight of the interstitial_structure signal.
# CHALLENGE_WEIGHT_INTERSTITIAL_STRUCTURE=80
# Weight of the vendor_script signal.
# CHALLENGE_WEIGHT_VENDOR_SCRIPT=60
# Weight of the vendor_presence signal.
# CHALLENGE_WEIGHT_VENDOR_PRESENCE=30
# Weight of the status_empty_body signal.
# CHALLENGE_WEIGHT_STATUS_EMPTY_BODY=200
# Weight of the status_small_body signal.
# CHALLENGE_WEIGHT_STATUS_SMALL_BODY=50
# Weight of the status_large_body signal.
# CHALLENGE_WEIGHT_STATUS_LARGE_BODY=20
# Weight of the captcha_input signal.
# CHALLENGE_WEIGHT_CAPTCHA_INPUT=50
# Weight of the captcha_element signal.
# CHALLENGE_WEIGHT_CAPTCHA_ELEMENT=40
# Weight of the form_dominance signal.
# CHALLENGE_WEIGHT_FORM_DOMINANCE=40
# Weight of the script_only_body signal.
# CHALLENGE_WEIGHT_SCRIPT_ONLY_BODY=40
# Weight of the thin_text signal.
# CHALLENGE_WEIGHT_THIN_TEXT=20
# Weight of the few_links signal.
# CHALLENGE_WEIGHT_FEW_LINKS=20
# Weight of the no_article signal.
# CHALLENGE_WEIGHT_NO_ARTICLE=20
# Weight of the rich_content guard signal.
# CHALLENGE_WEIGHT_RICH_CONTENT=-70
# Weight of the many_links guard signal.
# CHALLENGE_WEIGHT_MANY_LINKS=-20
# Weight of the served_page guard signal.
# CHALLENGE_WEIGHT_SERVED_PAGE=-30
# Weight of the phrase_title signal.
# CHALLENGE_WEIGHT_PHRASE_TITLE=60
# Weight of the phrase_body signal.
# CHALLENGE_WEIGHT_PHRASE_BODY=30
# Route reads through the 4b-camoufox tier. Optional: the code default `true` applies when unset.
# CAMOUFOX_ENABLED=true
# TTL in seconds for the per-domain tier memory. Optional: the code default `86400` applies when unset.
# TIER_MEMORY_TTL_SECONDS=86400
# Page-quiet poll interval in milliseconds for browser tiers. Optional: the code default `1000` applies when unset.
# NETWORKIDLE_POLL_MS=1000
# Pause in milliseconds between two scroll steps. Optional: the code default `200` applies when unset.
# SCROLL_PAUSE_MS=200
# Maximum size in bytes of the caller-supplied extraction schema. Optional: the code default `16384` applies when unset.
# EXTRACTION_SCHEMA_MAX_BYTES=16384
# Base URL of the OpenAI-compatible endpoint schema extraction calls. Empty turns the schema format off.
# EXTRACTION_LLM_BASE_URL=
# Model name sent to the extraction endpoint. Empty until the operator names one.
# EXTRACTION_LLM_MODEL=
# API key for the extraction endpoint, read from the repository .env file only.
EXTRACTION_LLM_API_KEY=
# Characters of the cleaned page markup sent to the extraction endpoint before the cap cuts them. Optional: the code default `60000` applies when unset.
# EXTRACTION_LLM_MAX_INPUT_CHARS=60000
# Timeout in seconds for one extraction model call. Optional: the code default `60` applies when unset.
# EXTRACTION_LLM_TIMEOUT_SECONDS=60
# TTL in seconds for a stored extraction recipe. Optional: the code default `604800` applies when unset.
# RECIPE_TTL_SECONDS=604800
# Maximum characters of one stored CSS selector. Optional: the code default `512` applies when unset.
# RECIPE_SELECTOR_MAX_CHARS=512
# Maximum bytes fetched for one routed PDF, image or audio file. Optional: the code default `52428800` applies when unset.
# DOCUMENT_MAX_BYTES=52428800
# Longest time one routed PDF, image or audio download may take, redirects included. A slower download is a failed download. Optional: the code default `300` applies when unset.
# DOCUMENT_FETCH_TIMEOUT_SECONDS=300
# Maximum bytes the browser tunnel carries from a site on one connection. A connection above it is closed. Optional: the code default `52428800` applies when unset.
# BROWSER_RESPONSE_MAX_BYTES=52428800
# Longest wait for a browser request head and for one connection of the browser tunnel. Optional: the code default `10.0` applies when unset.
# BROWSER_TUNNEL_CONNECT_TIMEOUT_SECONDS=10.0
# Longest time a browser tunnel connection may carry no bytes in either direction. Optional: the code default `60.0` applies when unset.
# BROWSER_TUNNEL_IDLE_TIMEOUT_SECONDS=60.0
# Most connections the browser tunnel carries at once. A connection above it answers 503. Optional: the code default `256` applies when unset.
# BROWSER_TUNNEL_MAX_CONNECTIONS=256
# Maximum bytes of one page answer the fast read tiers take, the compressed bytes and the inflated bytes alike. A larger answer ends that tier as a failure. Optional: the code default `52428800` applies when unset.
# READ_RESPONSE_MAX_BYTES=52428800
# Base URL of the docling-serve document conversion service. Empty turns the PDF route off. Optional: the compose default is empty, which turns the route off, because this stack runs no docling-serve.
# DOCLING_SERVE_URL=
# Base URL of the ascend-ocr service. Empty turns the image route off. Optional: the compose default is empty, which turns the route off, because this stack runs no ascend-ocr.
# ASCEND_OCR_URL=
# Timeout in seconds polling one ascend-ocr job. Optional: the code default `300` applies when unset.
# OCR_ROUTE_TIMEOUT_SECONDS=300
# Seconds shutdown waits for the background ascend-ocr job deletes before it cancels them. Optional: the code default `5` applies when unset.
# OCR_DELETE_DRAIN_SECONDS=5
# Base URL of the ascend-audio-scribe service. Empty turns the audio route off. Optional: the compose default is empty, which turns the route off, because this stack runs no ascend-audio-scribe.
# AUDIO_SCRIBE_URL=
# Wait in seconds between two connection attempts of the read cache purge subscriber. Optional: the code default `5` applies when unset.
# READ_CACHE_PURGE_RECONNECT_SECONDS=5
# Address of the S3-compatible store. Optional: the compose default `http://host.docker.internal:9070` applies when unset.
# OBJECT_STORE_S3_ENDPOINT=http://host.docker.internal:9070
# The address ascend-ocr signs its result addresses with. An OCR result on any other address is refused, and an accepted one is downloaded from OBJECT_STORE_S3_ENDPOINT with this address's host and port in the Host header. Optional: empty when unset, because this stack runs no ascend-ocr and the image route is off.
# OBJECT_STORE_S3_PUBLIC_ENDPOINT=
OBJECT_STORE_S3_ACCESS_KEY=
OBJECT_STORE_S3_SECRET_KEY=
# Most seeds in one crawl request. Optional: the code default `20` applies when unset.
# CRAWL_MAX_SEEDS=20
# Most include patterns and most exclude patterns in one crawl request. Optional: the code default `50` applies when unset.
# CRAWL_MAX_PATTERNS=50
# Largest `max_depth` a crawl request may ask for. Optional: the code default `5` applies when unset.
# CRAWL_MAX_DEPTH=5
# `max_depth` when the request has none. Optional: the code default `2` applies when unset.
# CRAWL_DEFAULT_DEPTH=2
# Largest `page_budget` a crawl request may ask for. Optional: the code default `10000` applies when unset.
# CRAWL_MAX_PAGES=10000
# `page_budget` when the request has none. Optional: the code default `100` applies when unset.
# CRAWL_DEFAULT_PAGE_BUDGET=100
# Bucket of the crawl results. Optional: the code default `web-hunter-crawls` applies when unset.
# CRAWL_RESULT_S3_BUCKET=web-hunter-crawls
# Key prefix of the crawl results after the tenant prefix. Optional: the code default `crawl-results/` applies when unset.
# CRAWL_RESULT_S3_PREFIX=crawl-results/
# Lifetime of job records, frontier keys and recrawl state in Redis. Result objects expire within one day after it through a bucket lifecycle rule in whole days, which needs s3:GetLifecycleConfiguration and s3:PutLifecycleConfiguration. Optional: the code default `604800` applies when unset.
# CRAWL_JOB_RETENTION_SECONDS=604800
# Pages of one domain read at once, all instances together. Optional: the code default `2` applies when unset.
# CRAWL_DOMAIN_CONCURRENCY=2
# Least time between two fetches of one domain. Optional: the code default `1` applies when unset.
# CRAWL_DEFAULT_DELAY_SECONDS=1
# Customer proxy for crawl fetches only. Empty turns it off.
# CRAWL_PROXY_URL=
# Optional outbound proxy for the fetch tiers and the browser tiers, for example http://user:pass@host:port. Empty turns it off.
# PROXY_URL=
# Lifetime of a page claim. Optional: the code default `120` applies when unset.
# CRAWL_CLAIM_LEASE_SECONDS=120
# Claim expiries after which a URL counts as failed. Optional: the code default `2` applies when unset.
# CRAWL_CLAIM_MAX_EXPIRIES=2
# Crawl worker tasks each instance starts. Optional: the code default `4` applies when unset.
# CRAWL_WORKER_CONCURRENCY=4
# Wait of a worker that found nothing to claim. Optional: the code default `1` applies when unset.
# CRAWL_WORKER_IDLE_SECONDS=1
# The `poll_after_seconds` hint of a crawl submission. Optional: the code default `5` applies when unset.
# CRAWL_POLL_AFTER_SECONDS=5
# Most sitemap files one instance fetches per job, over all its origins, sitemap indexes included. Optional: the code default `50` applies when unset.
# CRAWL_SITEMAP_MAX_DOCUMENTS=50
# Most bytes read from one sitemap file, before and after gzip inflation, a larger file is skipped. Optional: the code default `52428800` applies when unset.
# CRAWL_SITEMAP_MAX_BYTES=52428800
# Most bytes read from one robots.txt, at least the 500 KiB RFC 9309 requires, the rest of a larger file is ignored. Optional: the code default `512000` applies when unset.
# CRAWL_ROBOTS_MAX_BYTES=512000
# Most rule objects one robots.txt may expand to, counted as the rule sets of its user-agent lines times the rules of its other lines. A file above it disallows every page of its origin. Optional: the code default `1000000` applies when unset.
# CRAWL_ROBOTS_MAX_RULES=1000000
# Most parsed robots.txt files one instance keeps. The least recently used is evicted and fetched again when needed. Optional: the code default `256` applies when unset.
# CRAWL_ROBOTS_CACHE_MAX_ORIGINS=256
# Most rule objects the parsed robots.txt files of one instance may hold together. The least recently used files are evicted until the total is back under it. A value below `CRAWL_ROBOTS_MAX_RULES` is refused at startup. Optional: the code default `2000000` applies when unset.
# CRAWL_ROBOTS_CACHE_MAX_RULES=2000000
# A job ends once its pages skipped for robots.txt reach `page_budget` times this number. Optional: the code default `10` applies when unset.
# CRAWL_ROBOTS_SKIP_FACTOR=10
# Longest wait for one robots.txt. A file that takes longer counts as unreachable. Optional: the code default `30` applies when unset.
# CRAWL_ROBOTS_TIMEOUT_SECONDS=30
# Longest sitemap work of one page. Over it the work is logged and dropped and the page is still read. Refused at startup at or above `CRAWL_CLAIM_LEASE_SECONDS`. Optional: the code default `60` applies when unset.
# CRAWL_SITEMAP_TIMEOUT_SECONDS=60
# Largest `Crawl-delay` a robots.txt can ask for. A larger value is cut to this. Optional: the code default `60` applies when unset.
# CRAWL_MAX_DELAY_SECONDS=60

# Redis connection string for the web-search service's cookie/session cache.
# Optional: defaults to the bundled Redis service, which starts
# automatically with the stack. Leave this unset to use the bundled
# instance, or point it at an external Redis instead and scale the bundled
# service to zero (`docker compose up -d --scale redis=0`) if you don't
# want it running unused. See "Prerequisites" in README.md for every option.
REDIS_URL=
