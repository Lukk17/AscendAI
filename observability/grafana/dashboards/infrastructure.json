      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_stat_activity_count{datname=\"ascend_ai\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "title": "Postgres Connections (ascend_ai)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "PostgreSQL database size in bytes. Metric: pg_database_size_bytes from postgres-exporter.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 9,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_database_size_bytes{datname=\"ascend_ai\"}",
          "legendFormat": "ascend_ai",
          "refId": "A"
        }
      ],
      "title": "Postgres Database Size",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 10,
      "title": "MinIO",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "MinIO total objects stored. Metric: minio_bucket_objects from MinIO built-in Prometheus output.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 11,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "minio_bucket_objects",
          "legendFormat": "{{bucket}}",
          "refId": "A"
        }
      ],
      "title": "MinIO Objects per Bucket",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "MinIO total storage used per bucket in bytes. Metric: minio_bucket_usage_total_bytes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 12,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "minio_bucket_usage_total_bytes",
          "legendFormat": "{{bucket}}",
          "refId": "A"
        }
      ],
      "title": "MinIO Bucket Usage",
      "type": "timeseries"
    }
